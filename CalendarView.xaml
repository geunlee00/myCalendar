<UserControl x:Class="CalendarWidget.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CalendarWidget"
             xmlns:models="clr-namespace:CalendarWidget.Models">
    <UserControl.Resources>
        <!-- 탁상 달력 색: 미색 종이, 남색 글자, 빨간 강조 -->
        <SolidColorBrush x:Key="InkBrush" Color="#2E3440" />
        <SolidColorBrush x:Key="SubInkBrush" Color="#8A8172" />
        <SolidColorBrush x:Key="RedBrush" Color="#C8483D" />
        <SolidColorBrush x:Key="BlueBrush" Color="#3F6FB5" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F3ECDF" />
        <SolidColorBrush x:Key="PressedBrush" Color="#EBE1CC" />
        <SolidColorBrush x:Key="LineBrush" Color="#C9B998" />
        <local:TaskColorToBrushConverter x:Key="TaskColorToBrush" />

        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5C5548" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 남색 알약 버튼(추가, 저장) -->
        <ControlTemplate x:Key="PillButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <!-- 밑줄만 있는 입력칸 -->
        <Style x:Key="UnderlineTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,4" />
        </Style>

        <!-- 할 일 한 줄은 메모장 줄 간격(28)과 같은 높이로 맞춘다. -->
        <Style x:Key="TaskItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40E8DCC4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type models:CalendarTask}">
            <DockPanel Background="Transparent">
                <Button DockPanel.Dock="Right" Content="×" Width="24" Height="24" FontSize="14" Style="{StaticResource FlatButtonStyle}" Click="DeleteTask_Click" Tag="{Binding}" />
                <Button DockPanel.Dock="Right" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Width="24" Height="24" FontSize="11" Style="{StaticResource FlatButtonStyle}" Click="EditTask_Click" Tag="{Binding}" />
                <!-- 하루·여러 날 일정은 완료 체크, 반복 일정은 반복 표시 -->
                <Grid Width="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <CheckBox x:Name="Check" Focusable="False" IsChecked="{Binding IsCompleted}" />
                    <TextBlock x:Name="RepeatIcon" Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource SubInkBrush}" HorizontalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <Ellipse x:Name="ColorDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Color, Converter={StaticResource TaskColorToBrush}}" />
                <Border x:Name="DdayTag" Background="{StaticResource RedBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DdayLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border x:Name="ScheduleTag" Background="#E6EAF0" CornerRadius="3" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScheduleLabel}" FontSize="10.5" Foreground="#2E4A6B" />
                </Border>
                <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent" MouseLeftButtonDown="TaskTitle_MouseLeftButtonDown" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="#A8A090" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRecurring}" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RepeatIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Default">
                    <Setter TargetName="ColorDot" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ScheduleLabel}" Value="{x:Null}">
                    <Setter TargetName="ScheduleTag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DdayLabel}" Value="{x:Null}">
                    <Setter TargetName="DdayTag" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SearchResultTemplate">
            <DockPanel Background="Transparent" Cursor="Hand">
                <TextBlock Text="{Binding DateText}" Width="128" FontSize="11.5" Foreground="{StaticResource SubInkBrush}" VerticalAlignment="Center" />
                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding DotBrush}" />
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- 아래에 겹쳐 쌓인 종이 두 장. 맨 앞 종이 아래로 살짝 보인다. -->
        <Border x:Name="PageLayer2" Margin="14,20,14,0" CornerRadius="6" Background="#EDE6D6" BorderBrush="#DCD2BE" BorderThickness="1" />
        <Border x:Name="PageLayer1" Margin="7,16,7,4" CornerRadius="6" Background="#F5EFE3" BorderBrush="#E2D9C7" BorderThickness="1" />

        <!-- 맨 앞 종이 -->
        <Border x:Name="Card" Margin="0,12,0,8" CornerRadius="6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#5A4E3A" />
            </Border.Effect>
            <Grid>
                <!-- 스프링 아래 여백: 끌어서 위젯을 옮긴다. -->
                <Border Height="30" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

                <Grid x:Name="ContentGrid" Margin="22,30,22,16">
                    <!-- 배경이 투명할수록 글자 둘레에 흰 빛을 넣어 어떤 바탕화면에서도 읽히게 한다. -->
                    <Grid.Effect>
                        <DropShadowEffect x:Name="TextGlow" Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0" />
                    </Grid.Effect>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <!-- 머리: 큰 월 숫자. 끌어서 옮기고 휠로 달을 넘긴다. -->
                    <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseWheel="Calendar_MouseWheel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 폭이 좁으면 오른쪽 버튼 자리를 지키고 왼쪽 월 이름을 말줄임으로 줄인다. -->
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MonthNumberText" DockPanel.Dock="Left" FontFamily="Georgia" FontSize="48" FontWeight="Bold" Typography.NumeralStyle="Lining" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                            <StackPanel Margin="12,2,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthNameText" FontFamily="Georgia" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="YearText" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SubInkBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SearchButton" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28" FontSize="13" Style="{StaticResource FlatButtonStyle}" Click="SearchButton_Click" />
                            <Button x:Name="PrevButton" Content="‹" Width="28" Height="28" FontSize="20" Style="{StaticResource FlatButtonStyle}" Click="PreviousMonth_Click" />
                            <Button x:Name="TodayButton" Height="28" Padding="8,0" FontSize="12" Foreground="{StaticResource RedBrush}" Style="{StaticResource FlatButtonStyle}" Click="Today_Click" />
                            <Button x:Name="NextButton" Content="›" Width="28" Height="28" FontSize="20" Style="{StaticResource FlatButtonStyle}" Click="NextMonth_Click" />
                            <Border Width="1" Height="16" Margin="6,0" Background="#DDD3C0" />
                            <!-- 새 버전이 있을 때만 보인다. 누르면 내려받기 페이지가 열린다. -->
                            <Button x:Name="UpdateBadge" Visibility="Collapsed" Height="20" Margin="0,0,4,0" Padding="7,0"
                                    FontSize="11" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Focusable="False" Click="UpdateBadge_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource RedBrush}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="MenuButton" Content="⋯" Width="28" Height="28" FontSize="16" Style="{StaticResource FlatButtonStyle}" Click="MenuButton_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="AutoStartMenuItem" IsCheckable="True" Click="AutoStartMenuItem_Click" />
                                        <MenuItem x:Name="ResetBoundsMenuItem" Click="ResetBounds_Click" />
                                        <MenuItem x:Name="HolidaysMenuItem" IsCheckable="True" Click="HolidaysMenuItem_Click" />
                                        <MenuItem x:Name="UpdateMenuItem" StaysOpenOnClick="True" Click="UpdateMenuItem_Click" />
                                        <MenuItem x:Name="LanguageMenuItem">
                                            <MenuItem x:Name="KoreanMenuItem" Header="한국어" IsCheckable="True" Click="KoreanMenuItem_Click" />
                                            <MenuItem x:Name="EnglishMenuItem" Header="English" IsCheckable="True" Click="EnglishMenuItem_Click" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem StaysOpenOnClick="True" Focusable="False">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock x:Name="TransparencyText" Margin="0,2,0,4" />
                                                    <Slider x:Name="TransparencySlider" Width="160" Minimum="0" Maximum="100"
                                                            SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False"
                                                            ValueChanged="TransparencySlider_ValueChanged" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem x:Name="QuitMenuItem" Click="Close_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="CloseButton" Content="×" Width="28" Height="28" FontSize="17" Style="{StaticResource FlatButtonStyle}" Click="Close_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 요일: 언어에 맞춰 코드에서 채운다. 아래에 진한 선을 그어 인쇄된 달력처럼 나눈다. -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1.5">
                        <UniformGrid x:Name="WeekdayHeader" Columns="7" />
                    </Border>

                    <!-- 날짜 칸: 클릭하면 선택, 끌면 기간 선택, 일정을 끌면 옮기기, 더블클릭하면 입력이나 편집. 휠로 달을 넘긴다. -->
                    <!-- 위쪽 선은 요일 아래 선이 맡고, 바깥 왼쪽 선과 칸마다 오른쪽·아래쪽 선을 그어 선이 겹치지 않게 한다. -->
                    <Border Grid.Row="2" BorderBrush="#E6DDCB" BorderThickness="1,0,0,0">
                        <UniformGrid x:Name="DayGrid" Columns="7" Background="Transparent"
                                     MouseWheel="Calendar_MouseWheel"
                                     PreviewMouseLeftButtonDown="DayGrid_PreviewMouseLeftButtonDown"
                                     PreviewMouseLeftButtonUp="DayGrid_PreviewMouseLeftButtonUp"
                                     MouseMove="DayGrid_MouseMove"
                                     SizeChanged="DayGrid_SizeChanged" />
                    </Border>

                    <!-- 메모장: 목록 / 편집 / 검색 중 하나만 보인다. -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1.5">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <TextBlock Text="MEMO" FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="SelectedDateText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelectedHolidayText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- 날짜를 먼저 보여 주고, D-day는 남는 자리에서 오른쪽에 붙여 넘치면 말줄임으로 줄인다. -->
                                <TextBlock x:Name="DdayText" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Border>

                        <!-- 목록: 선택한 날짜(기간)의 할 일과 입력칸 -->
                        <Grid x:Name="ListPanel" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <!-- 줄 노트처럼 28 간격으로 가로줄을 긋는다. 줄 색은 투명도에 맞춰 코드에서 정한다. -->
                            <Border x:Name="MemoLines" />
                            <ListBox x:Name="TaskList" BorderThickness="0" Background="Transparent"
                                     ItemTemplate="{StaticResource TaskTemplate}" ItemContainerStyle="{StaticResource TaskItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <TextBlock x:Name="EmptyListText" Margin="6,6,0,0" FontSize="12" Foreground="#A8A090" IsHitTestVisible="False" />
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TaskInput" Grid.Column="0" Height="30" Style="{StaticResource UnderlineTextBox}" KeyDown="TaskInput_KeyDown" />
                                <TextBlock x:Name="InputHint" Grid.Column="0" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#B0A796" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TaskInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="AddButton" Grid.Column="1" MinWidth="56" Margin="8,0,0,0" Height="30" Padding="10,0" Click="AddTask_Click" FontWeight="SemiBold" Cursor="Hand" Template="{StaticResource PillButtonTemplate}" />
                            </Grid>
                        </Grid>

                        <!-- 편집: 제목, 날짜(달력에서 고르기), 반복과 D-day, 색과 버튼 -->
                        <Grid x:Name="EditorPanel" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EditorTitle" Grid.ColumnSpan="2" Height="28" FontSize="13" Style="{StaticResource UnderlineTextBox}" KeyDown="EditorTitle_KeyDown" />

                            <TextBlock x:Name="EditorDateLabel" Grid.Row="1" FontSize="11.5" Foreground="{StaticResource SubInkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="EditorDateText" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock x:Name="EditorDateHint" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource SubInkBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="EditorRepeatLabel" Grid.Row="2" FontSize="11.5" Foreground="{StaticResource SubInkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DockPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox x:Name="EditorDday" DockPanel.Dock="Right" VerticalAlignment="Center" Focusable="False" Foreground="{StaticResource InkBrush}" FontSize="11.5" />
                                <StackPanel x:Name="RepeatOptions" Orientation="Horizontal" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock x:Name="EditorColorLabel" Grid.Row="3" FontSize="11.5" Foreground="{StaticResource SubInkBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <DockPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="EditorDelete" Height="26" Padding="8,0" Margin="0,0,2,0" Foreground="{StaticResource RedBrush}" Style="{StaticResource FlatButtonStyle}" Click="EditorDelete_Click" />
                                    <Button x:Name="EditorCancel" Height="26" Padding="8,0" Margin="0,0,6,0" Style="{StaticResource FlatButtonStyle}" Click="EditorCancel_Click" />
                                    <Button x:Name="EditorSave" Height="26" Padding="14,0" FontWeight="SemiBold" Cursor="Hand" Template="{StaticResource PillButtonTemplate}" Click="EditorSave_Click" />
                                </StackPanel>
                                <StackPanel x:Name="ColorOptions" Orientation="Horizontal" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>

                        <!-- 검색: 일정 이름으로 찾고, 결과를 누르면 그 날짜로 간다. -->
                        <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,4,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="SearchInput" Height="28" Style="{StaticResource UnderlineTextBox}" TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
                            <TextBlock x:Name="SearchHint" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#B0A796" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="SearchResults" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                     ItemTemplate="{StaticResource SearchResultTemplate}" ItemContainerStyle="{StaticResource TaskItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonUp="SearchResults_PreviewMouseLeftButtonUp" />
                            <TextBlock x:Name="SearchEmptyText" Grid.Row="1" Margin="6,6,0,0" FontSize="12" Foreground="#A8A090" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 크기 조절: 네 변과 네 모서리 어디를 끌어도 된다. 오른쪽 아래에는 눈에 보이는 빗금을 둔다. -->
                <Grid x:Name="ResizeHandles">
                    <Grid.Resources>
                        <ControlTemplate x:Key="InvisibleThumb" TargetType="Thumb">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                        <Style TargetType="Thumb">
                            <Setter Property="Template" Value="{StaticResource InvisibleThumb}" />
                            <EventSetter Event="DragDelta" Handler="ResizeHandle_DragDelta" />
                            <EventSetter Event="DragCompleted" Handler="ResizeHandle_DragCompleted" />
                        </Style>
                    </Grid.Resources>
                    <Thumb Tag="Left" Width="6" HorizontalAlignment="Left" Margin="0,14,0,14" Cursor="SizeWE" />
                    <Thumb Tag="Right" Width="6" HorizontalAlignment="Right" Margin="0,14,0,14" Cursor="SizeWE" />
                    <Thumb Tag="Top" Height="6" VerticalAlignment="Top" Margin="14,0,14,0" Cursor="SizeNS" />
                    <Thumb Tag="Bottom" Height="6" VerticalAlignment="Bottom" Margin="14,0,14,0" Cursor="SizeNS" />
                    <Thumb Tag="Left,Top" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
                    <Thumb Tag="Right,Top" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
                    <Thumb Tag="Left,Bottom" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
                    <Thumb x:Name="ResizeGrip" Tag="Right,Bottom" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M 15,5 L 5,15 M 15,10 L 10,15" Stroke="#C2B8A5" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>

        <!-- 스프링 고리: 종이 위쪽 가장자리를 넘어 구멍에 꿰어진 모습. 크기에 맞춰 코드에서 그린다. -->
        <Canvas x:Name="RingsLayer" Height="40" VerticalAlignment="Top" IsHitTestVisible="False" SizeChanged="RingsLayer_SizeChanged" />
    </Grid>
</UserControl>
