<UserControl x:Class="CalendarWidget.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CalendarWidget.Models">
    <UserControl.Resources>
        <!-- 탁상 달력 색: 미색 종이, 남색 글자, 빨간 강조 -->
        <SolidColorBrush x:Key="InkBrush" Color="#2E3440" />
        <SolidColorBrush x:Key="SubInkBrush" Color="#8A8172" />
        <SolidColorBrush x:Key="RedBrush" Color="#C8483D" />
        <SolidColorBrush x:Key="BlueBrush" Color="#3F6FB5" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F3ECDF" />
        <SolidColorBrush x:Key="PressedBrush" Color="#EBE1CC" />

        <Style x:Key="DayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5C5548" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 할 일 한 줄은 메모장 줄 간격(28)과 같은 높이로 맞춘다. -->
        <Style x:Key="TaskItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40E8DCC4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type models:CalendarTask}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Width="24" Height="24" FontSize="14" Style="{StaticResource FlatButtonStyle}" Click="DeleteTask_Click" Tag="{Binding}" ToolTip="삭제" />
                <CheckBox VerticalAlignment="Center" Margin="0,0,8,0" Focusable="False" IsChecked="{Binding IsCompleted}" />
                <Grid VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" Background="Transparent" MouseLeftButtonDown="TaskTitle_MouseLeftButtonDown" ToolTip="더블클릭해서 이름 고치기" />
                    <TextBox x:Name="TitleEditor" Visibility="Collapsed" Text="{Binding Title, Mode=OneWay}" Padding="2,1" BorderBrush="#C9B998" KeyDown="TitleEditor_KeyDown" LostKeyboardFocus="TitleEditor_LostKeyboardFocus" IsVisibleChanged="TitleEditor_IsVisibleChanged" />
                </Grid>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="#A8A090" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TitleEditor" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <!-- 아래에 겹쳐 쌓인 종이 두 장. 맨 앞 종이 아래로 살짝 보인다. -->
        <Border x:Name="PageLayer2" Margin="14,20,14,0" CornerRadius="6" Background="#EDE6D6" BorderBrush="#DCD2BE" BorderThickness="1" />
        <Border x:Name="PageLayer1" Margin="7,16,7,4" CornerRadius="6" Background="#F5EFE3" BorderBrush="#E2D9C7" BorderThickness="1" />

        <!-- 맨 앞 종이 -->
        <Border x:Name="Card" Margin="0,12,0,8" CornerRadius="6" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#5A4E3A" />
            </Border.Effect>
            <Grid>
                <!-- 스프링 아래 여백: 끌어서 위젯을 옮긴다. -->
                <Border Height="30" VerticalAlignment="Top" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" />

                <Grid x:Name="ContentGrid" Margin="22,30,22,16">
                    <!-- 배경이 투명할수록 글자 둘레에 흰 빛을 넣어 어떤 바탕화면에서도 읽히게 한다. -->
                    <Grid.Effect>
                        <DropShadowEffect x:Name="TextGlow" Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0" />
                    </Grid.Effect>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="190" />
                    </Grid.RowDefinitions>

                    <!-- 머리: 큰 월 숫자. 끌어서 옮기고 휠로 달을 넘긴다. -->
                    <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseWheel="Calendar_MouseWheel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthNumberText" FontFamily="Georgia" FontSize="48" FontWeight="Bold" Typography.NumeralStyle="Lining" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                            <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MonthNameText" FontFamily="Georgia" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock x:Name="YearText" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SubInkBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="‹" Width="28" Height="28" FontSize="20" Style="{StaticResource FlatButtonStyle}" Click="PreviousMonth_Click" ToolTip="이전 달" />
                            <Button Content="오늘" Height="28" Padding="8,0" FontSize="12" Foreground="{StaticResource RedBrush}" Style="{StaticResource FlatButtonStyle}" Click="Today_Click" ToolTip="오늘로 돌아가기" />
                            <Button Content="›" Width="28" Height="28" FontSize="20" Style="{StaticResource FlatButtonStyle}" Click="NextMonth_Click" ToolTip="다음 달" />
                            <Border Width="1" Height="16" Margin="6,0" Background="#DDD3C0" />
                            <Button x:Name="MenuButton" Content="⋯" Width="28" Height="28" FontSize="16" Style="{StaticResource FlatButtonStyle}" Click="MenuButton_Click" ToolTip="설정">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="AutoStartMenuItem" Header="Windows 시작 시 자동 실행" IsCheckable="True" Click="AutoStartMenuItem_Click" />
                                        <MenuItem Header="위치·크기 처음으로" Click="ResetBounds_Click" />
                                        <Separator />
                                        <MenuItem StaysOpenOnClick="True" Focusable="False">
                                            <MenuItem.Header>
                                                <StackPanel>
                                                    <TextBlock x:Name="TransparencyText" Text="배경 투명도 0%" Margin="0,2,0,4" />
                                                    <Slider x:Name="TransparencySlider" Width="160" Minimum="0" Maximum="100"
                                                            SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False"
                                                            ValueChanged="TransparencySlider_ValueChanged" />
                                                </StackPanel>
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="끝내기" Click="Close_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="×" Width="28" Height="28" FontSize="17" Style="{StaticResource FlatButtonStyle}" Click="Close_Click" ToolTip="끝내기" />
                        </StackPanel>
                    </Grid>

                    <!-- 요일: 아래에 진한 선을 그어 인쇄된 달력처럼 나눈다. -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1.5">
                        <UniformGrid Columns="7">
                            <TextBlock Text="일" FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="월" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="화" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="수" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="목" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="금" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="토" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>

                    <!-- 날짜 칸: 클릭하면 선택, 더블클릭하면 바로 입력. 휠로 달을 넘긴다. -->
                    <!-- 위쪽 선은 요일 아래 선이 맡고, 바깥 왼쪽 선과 칸마다 오른쪽·아래쪽 선을 그어 선이 겹치지 않게 한다. -->
                    <Border Grid.Row="2" BorderBrush="#E6DDCB" BorderThickness="1,0,0,0">
                        <UniformGrid x:Name="DayGrid" Columns="7" Background="Transparent"
                                     MouseWheel="Calendar_MouseWheel"
                                     PreviewMouseLeftButtonDown="DayGrid_PreviewMouseLeftButtonDown"
                                     SizeChanged="DayGrid_SizeChanged" />
                    </Border>

                    <!-- 메모장: 선택한 날짜의 할 일 -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,1.5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MEMO" FontFamily="Georgia" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="SelectedDateText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectedHolidayText" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- 줄 노트처럼 28 간격으로 가로줄을 긋는다. 줄 색은 투명도에 맞춰 코드에서 정한다. -->
                        <Border x:Name="MemoLines" Grid.Row="1" />
                        <ListBox x:Name="TaskList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                 ItemTemplate="{StaticResource TaskTemplate}" ItemContainerStyle="{StaticResource TaskItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        <TextBlock x:Name="EmptyListText" Grid.Row="1" Text="할 일이 없어요" Margin="6,6,0,0" FontSize="12" Foreground="#A8A090" IsHitTestVisible="False" />
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TaskInput" Grid.Column="0" Height="30" Padding="4,5" BorderThickness="0,0,0,1.5" Background="Transparent" Foreground="{StaticResource InkBrush}" VerticalContentAlignment="Center" KeyDown="TaskInput_KeyDown" />
                            <TextBlock Grid.Column="0" Text="✎  할 일을 적고 Enter" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#B0A796" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TaskInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="AddButton" Grid.Column="1" Content="추가" Margin="8,0,0,0" Height="30" Click="AddTask_Click" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 오른쪽 아래 모서리: 끌어서 크기를 바꾼다. -->
                <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Margin="0,0,3,3"
                       Cursor="SizeNWSE" ToolTip="끌어서 크기 바꾸기"
                       DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M 14,4 L 4,14 M 14,9 L 9,14" Stroke="#C2B8A5" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- 스프링 고리: 종이 위쪽 가장자리를 넘어 구멍에 꿰어진 모습. 크기에 맞춰 코드에서 그린다. -->
        <Canvas x:Name="RingsLayer" Height="40" VerticalAlignment="Top" IsHitTestVisible="False" SizeChanged="RingsLayer_SizeChanged" />
    </Grid>
</UserControl>
